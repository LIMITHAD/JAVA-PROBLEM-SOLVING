import java.util.*;
public class Main{
    public static void main(String[] args){
        Scanner in=new Scanner(System.in);
        int n=in.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=in.nextInt();
        }
        int max=0;
        for(int i=1;i<n;i++){
            int a1=arr[i-1];
            int b1=arr[i];
            int a=a1;
            int b=b1;
            while(b!=0){
                int temp=b;
                b=a%b;
                a=temp;
            }
            int gcd=a;
            int lcm= a1*b1/gcd;
            System.out.println(lcm);
            if(lcm>max){
                max=lcm;
            }
        }
        System.out.println(max);
    }
}
